set(CMAKE_SYSTEM_NAME @CMAKE_SYSTEM_NAME@)
set(CMAKE_SYSTEM_PROCESSOR @CMAKE_SYSTEM_PROCESSOR@)

# CMAKE_SYSROOT here is the dep-install prefix ($SYSROOT/usr); the Windows
# SDK + CRT live under a separate xwin-managed tree, accessed via clang-cl's
# -winsysroot flag (baked into CMAKE_<LANG>_COMPILER below) and lld-link's
# /winsysroot: flag (baked into CMAKE_LINKER below).
set(CMAKE_SYSROOT @SYSROOT_PATH@)

set(CMAKE_C_COMPILER @CC@ @COMBINED_C_FLAGS@)
set(CMAKE_C_COMPILER_TARGET @TARGET_TRIPLE@)
set(CMAKE_CXX_COMPILER @CXX@ @COMBINED_CXX_FLAGS@)
set(CMAKE_CXX_COMPILER_TARGET @TARGET_TRIPLE@)
set(CMAKE_AR @AR@)

# CMake invokes the linker directly (via `cmake -E vs_link_exe -- <linker> ...`),
# bypassing the clang-cl driver, so a -winsysroot baked into CMAKE_<LANG>_COMPILER
# would not reach it. CMAKE_LINKER on Windows is also strictly a single path —
# CMake's placeholder expander runs it through a path-quoter, not list-expander
# (cmRulePlaceholderExpander.cxx, <CMAKE_LINKER> handling), so we can't put
# extra args there. Instead, @LINKER@ here points at a thin wrapper shipped
# inside the sysroot that prepends /winsysroot: and execs the real lld-link;
# CMake sees a single path and is none the wiser.
set(CMAKE_LINKER @LINKER@)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
