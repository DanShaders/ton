set(CMAKE_SYSTEM_NAME @CMAKE_SYSTEM_NAME@)
set(CMAKE_SYSTEM_PROCESSOR @CMAKE_SYSTEM_PROCESSOR@)

# CMAKE_SYSROOT here is the dep-install prefix ($SYSROOT/usr); the Windows
# SDK + CRT live under a separate xwin-managed tree, accessed via /winsysroot:
# (added below as a compile + link option).
set(CMAKE_SYSROOT @SYSROOT_PATH@)

set(CMAKE_C_COMPILER @CC@)
set(CMAKE_C_COMPILER_TARGET @TARGET_TRIPLE@)
set(CMAKE_CXX_COMPILER @CXX@)
set(CMAKE_CXX_COMPILER_TARGET @TARGET_TRIPLE@)
set(CMAKE_AR @AR@)
set(CMAKE_LINKER @LINKER@)

add_compile_options(@COMPILE_OPTIONS@)
add_link_options(@LINK_OPTIONS@)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
